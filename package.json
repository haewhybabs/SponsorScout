{
  "name": "sponsorscout",
  "version": "1.0.0",
  "description": "Personal daily digest of UK software engineering jobs likely to offer Skilled Worker visa sponsorship and pay above the ILR salary threshold.",
  "private": true,
  "type": "module",
  "bin": {
    "scout": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "scout": "tsx src/cli.ts",
    "dev": "tsx watch src/cli.ts serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "packageManager": "pnpm@12.16.1",
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cheerio": "^1.0.0",
    "csv-parse": "^5.6.0",
    "fuse.js": "^7.1.0",
    "marked": "^18.1.3",
    "pino": "^9.6.0",
    "puppeteer": "^25.16.0",
    "rss-parser": "^3.13.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
